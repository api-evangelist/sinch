{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sinch Brands Access Control Lists Available Regions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Available Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Available Regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/availableRegions",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "types",
                "value": "",
                "type": "query",
                "description": "Filter by number types"
              }
            ]
          },
          "docs": "Returns a list of available regions and the types of phone numbers that can be provisioned in each region."
        }
      ]
    }
  ],
  "bundled": true
}