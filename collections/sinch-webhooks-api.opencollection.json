{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sinch Brands Access Control Lists Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/apps/:app_id/webhooks",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The unique app identifier"
              }
            ]
          },
          "docs": "Returns the list of webhooks configured for a specific app. Up to 5 webhooks can be configured per app."
        },
        {
          "info": {
            "name": "Create a Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/apps/:app_id/webhooks",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The unique app identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new webhook for the specified app with trigger subscriptions."
        },
        {
          "info": {
            "name": "Get a Webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "The unique webhook identifier"
              }
            ]
          },
          "docs": "Returns the details of a specific webhook."
        },
        {
          "info": {
            "name": "Update a Webhook",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "The unique webhook identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the properties of a specific webhook."
        },
        {
          "info": {
            "name": "Delete a Webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "The unique webhook identifier"
              }
            ]
          },
          "docs": "Deletes a specific webhook."
        }
      ]
    }
  ],
  "bundled": true
}