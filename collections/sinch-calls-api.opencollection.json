{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sinch Brands Access Control Lists Calls API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Calls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Call Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://brands.api.sinch.com/calling/v1/calls/id/:call_id",
            "params": [
              {
                "name": "call_id",
                "value": "",
                "type": "path",
                "description": "The unique call identifier"
              }
            ]
          },
          "docs": "Returns information about a specific call identified by the call ID."
        },
        {
          "info": {
            "name": "Update a Call",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://brands.api.sinch.com/calling/v1/calls/id/:call_id",
            "params": [
              {
                "name": "call_id",
                "value": "",
                "type": "path",
                "description": "The unique call identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an ongoing call with SVAML instructions. Can be used to play prompts, connect calls, or hang up."
        }
      ]
    }
  ],
  "bundled": true
}