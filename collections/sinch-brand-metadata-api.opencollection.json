{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sinch Brands Access Control Lists Brand Metadata API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Brand Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Brand Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://brands.api.sinch.com/v1/projects/:project_id/brand-metadata",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The unique project identifier"
              }
            ]
          },
          "docs": "Returns metadata about brand configuration options including available industries, entity types, and required fields."
        }
      ]
    }
  ],
  "bundled": true
}